# Copy this file to .env and fill it in. Never commit .env.

# Your MongoDB Atlas connection string. Keep "union-dash" before the "?" so
# the data goes into its own database.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/union-dash?retryWrites=true&w=majority

# Only needed on Vercel: any long random text. Vercel's daily cron job sends
# it to /api/import, and the server refuses import requests without it.
CRON_SECRET=
